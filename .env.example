# Hugging Face token (optional, helps avoid rate limits when downloading models)
HF_TOKEN=

# Anthropic API key (required for transcript cleanup and summary features)
ANTHROPIC_API_KEY=

# Whisper model settings
# CPU mode: Use smaller models (tiny, base, small)
# GPU mode: Can use larger models (medium, large-v3)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# Language settings
# Set to a specific language code (en, es, fr, etc.) or leave empty for auto-detection
WHISPER_LANGUAGE=en

# Claude model for cleanup (optional, uses default if not set)
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Flask web server settings (optional, uses defaults if not set)
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# Storage directories (customize these for your setup)
# The location where uploaded audio files are stored
UPLOAD_DIR=./uploads

# The location where output files (transcripts, summaries) are stored
OUTPUT_DIR=./output

# The location where Whisper models are cached
MODEL_CACHE_DIR=./model_cache

# Example for Unraid (uncomment and modify):
# UPLOAD_DIR=/mnt/user/audio-transcribe/uploads
# OUTPUT_DIR=/mnt/user/audio-transcribe/output
# MODEL_CACHE_DIR=/mnt/user/audio-transcribe/model_cache
